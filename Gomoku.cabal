name:                Gomoku
version:             0.1.0.0
synopsis:            Gomoku (5-in-a-row) game
-- description:         
homepage:            http://studres.cs.st-andrews.ac.uk/CS2006
author:              Edwin Brady
maintainer:          ecb10@st-andrews.ac.uk
category:            Game
build-type:          Simple
cabal-version:       >=1.10

executable gomoku
  main-is:             Main.hs
  Other-modules:       Board, AI, Types, Protocol, SGF, GUI.Input, GUI.Draw, GUI.GameScreen, GUI.Background, GUI.Menu.MainMenu, 
                       GUI.Menu.PanelMenu, GUI.Menu.OptionsMenu, GUI.Menu.PauseMenu, GUI.Menu.EndScreen, GUI.Menu.ConnectMenu, 
                       GUI.Menu.WaitingForConnectionMenu, GUI.Menu.ReplayMenu, Parser.WorldParser, Parser.ArgumentParser, Parser.SGFParser
  build-depends:       base, gloss, parsec, aeson, bmp, time, bytestring, network < 3.0, ghc >= 9.2.5
  hs-source-dirs:      src
  default-language:    Haskell2010
